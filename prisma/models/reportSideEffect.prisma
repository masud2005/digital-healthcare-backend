model SymptomSeverity {
    id String @id @default(uuid())

    text  String @db.VarChar(255) // e.g. "Mild - Manageable, not affecting daily life"
    order Int    @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model EmergencyContactWidget {
    id String @id @default(uuid())

    sectionTitle String @db.VarChar(255)

    contacts EmergencyContact[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model EmergencyContact {
    id String @id @default(uuid())

    widgetId String
    widget   EmergencyContactWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

    title   String @db.VarChar(255)
    contact String @db.VarChar(255)
    notes   String @db.Text

    order Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
