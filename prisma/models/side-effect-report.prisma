model SideEffectReport {
  id String @id @default(uuid())

  firstName   String
  lastName    String
  email       String
  phone       String?
  severity    SideEffectSeverity
  description String             @db.Text
  status      SideEffectStatus   @default(PENDING)

  serviceId  String   @map("service_id")
  service    Category @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId String   @map("provider_id")
  provider   DoctorProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("side_effect_reports")
}
