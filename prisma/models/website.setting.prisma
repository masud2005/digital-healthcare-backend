model SiteSettings {
  id              String  @id @default(cuid())
  title           String
  metaDescription String?

  // Branding Assets (Stored as relations to Attachment)
  whiteLogoId     String?     @unique @map("white_logo_id")
  whiteLogo       Attachment? @relation("WhiteLogo", fields: [whiteLogoId], references: [id], onDelete: Cascade)
  blackLogoId     String?     @unique @map("black_logo_id")
  blackLogo       Attachment? @relation("BlackLogo", fields: [blackLogoId], references: [id], onDelete: Cascade)
  faviconLightId  String?     @unique @map("favicon_light_id")
  faviconLight    Attachment? @relation("FaviconLight", fields: [faviconLightId], references: [id], onDelete: Cascade)
  faviconDarkId   String?     @unique @map("favicon_dark_id")
  faviconDark     Attachment? @relation("FaviconDark", fields: [faviconDarkId], references: [id], onDelete: Cascade)
  socialPreviewId String?     @unique @map("social_preview_id")
  socialPreview   Attachment? @relation("SocialPreview", fields: [socialPreviewId], references: [id], onDelete: Cascade)

  // Contact Info
  phone      String?
  email      String?
  openHours  String? // e.g. "Mon - Fri: 9AM - 2PM"
  closedDays String? // e.g. "Sat - Sun"

  // Analytics
  gaMeasurementId String?

  // Relation to offices (One site, many offices)
  offices OfficeLocation[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  socialLinks SocialLink[]
}

// 2. Office Locations (DRY: Handles any number of offices)
model OfficeLocation {
  id String @id @default(cuid())

  // Link back to the main site
  siteId String
  site   SiteSettings @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Location Details
  name    String // e.g. "Colorado Springs", "Cherry Creek"
  address String // e.g. "1625 Medical Center Point, Suite 120"
  city    String?
  state   String?
  zipCode String?

  isActive Boolean @default(true) // To toggle visibility without deleting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional: If you need social links per location
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  linkedinUrl  String?
}

model SocialLink {
  id       String       @id @default(cuid())
  siteId   String
  site     SiteSettings @relation(fields: [siteId], references: [id])
  platform String // "facebook", "twitter", etc.
  url      String
}
