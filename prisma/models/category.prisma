model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)

  // Icon (attachment)
  iconId String?     @unique
  icon   Attachment? @relation(fields: [iconId], references: [id], onDelete: Cascade)

  // Relations
  products                 Product[]
  assessments              Assessment[]
  patients                 User[]
  sideEffectReports        SideEffectReport[]
  allowedStates            StateCoverage[]    @relation("StateAllowedCategories")
  subscriptions            Subscription[]
  blogs                    Blog[]
  homePageFeaturedService1 HomePageContent[]  @relation("AboutFeaturedService1")
  homePageFeaturedService2 HomePageContent[]  @relation("AboutFeaturedService2")
  homePageFeaturedService3 HomePageContent[]  @relation("AboutFeaturedService3")

  servicePageHeroSection   ServicePageHeroSection?
  servicePageSecondSection ServicePageSecondSection?
  servicePageFaqSection    ServicePageFaqSection?
  ctaSections              BottomCtaSection[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  paymentPlan   PaymentPlan?
  conversations Conversation[]

  @@index([status])
  @@index([name])
  @@index([slug])
}

model PaymentPlan {
  id           String       @id @default(uuid())
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle @default(MONTHLY)

  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
