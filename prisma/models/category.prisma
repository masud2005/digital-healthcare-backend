model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)

  // Relations
  products    Product[]
  assessments Assessment[]
  patients    User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
}
