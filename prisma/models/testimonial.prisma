model Testimonial {
  id String @id @default(uuid())

  clientName String   @map("client_name")
  feedback   String?  @map("feedback") @db.Text // Nullable if feedback is optional
  rating     Float    @map("rating") // Storing as Float to allow values like 5.0
  date       DateTime @map("date")

  avatarId String?     @unique @map("avatar_id")
  avatar   Attachment? @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}
