model Testimonial {
  id String @id @default(uuid())

  clientName String   @map("client_name")
  feedback   String?  @map("feedback") @db.Text // Nullable if feedback is optional
  rating     Float    @map("rating") // Storing as Float to allow values like 5.0
  date       DateTime @map("date")

  avatarId String?     @unique @map("avatar_id")
  avatar   Attachment? @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  isPublished Boolean @default(true) @map("is_published")

  // Google Places sync fields — nullable so existing rows are unaffected
  googleReviewId      String? @unique @map("google_review_id") // stable key from Places API v1 review name
  isGoogleReviewDirty Boolean @default(false) @map("is_google_review_dirty") // true = admin edited; cron will skip
  googleAvatarUrl     String? @map("google_avatar_url") // profile photo URL from Google (external CDN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}
