model Attachment {
  id       String            @id @default(uuid())
  fileName String
  fileUrl  String
  fileType String
  fileSize Int
  context  AttachmentContext

  // Optional relation to User who uploaded the attachment
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  // Back-relations
  category  Category?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?

  homePageContentHeroMedia    HomePageContent? @relation("HeroMedia")
  homePageContentBadge        HomePageContent? @relation("HeroBadgeImage")
  homePageContentAboutMedia   HomePageContent? @relation("AboutMedia")
  homePageContentFaqCardMedia HomePageContent? @relation("FaqCardMedia")
  whiteLogoSettings           SiteSettings?    @relation("WhiteLogo")
  blackLogoSettings           SiteSettings?    @relation("BlackLogo")
  faviconLightSettings        SiteSettings?    @relation("FaviconLight")
  faviconDarkSettings         SiteSettings?    @relation("FaviconDark")
  socialPreviewSettings       SiteSettings?    @relation("SocialPreview")
  doctorProfile               DoctorProfile?   @relation("DoctorAvatar")
  patientProfile              PatientProfile?  @relation("PatientAvatar")
  adminProfile                AdminProfile?    @relation("AdminAvatar")
  contactLead                 ContactLead?     @relation("ContactLeadAttachment")
  contactLeadResponse         ContactLead?     @relation("ContactLeadResponseAttachment")
  testimonial                 Testimonial?
  blogFeaturedImage           Blog?            @relation("BlogFeaturedImage")
  emailLayout                 EmailLayout?     @relation("EmailLayoutLogo")

  servicePageHeroSection   ServicePageHeroSection?   @relation("HeroBanner")
  servicePageSecondSection ServicePageSecondSection? @relation("SecondSectionMedia")

  sideWidgets SideWidget[]

  contactSideWidgets ContactSideWidget[] @relation("ContactSideWidgetImage")
  contactPartners    ContactPartner[]    @relation("ContactPartnerImage")

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sideEffectReportId String?           @map("side_effect_report_id")
  sideEffectReport   SideEffectReport? @relation(fields: [sideEffectReportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([context])
  @@index([uploadedById, context])
  @@index([productId])
  @@index([sideEffectReportId])
  @@index([conversationId])
}
