model Attachment {
    id       String @id @default(uuid())
    fileName String
    fileUrl  String
    fileType String
    fileSize Int
    context AttachmentContext

    // Optional relation to User who uploaded the attachment
    uploadedById String?
    uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

    // Back-relations
    category     Category?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([context])
    @@index([uploadedById, context])
}
