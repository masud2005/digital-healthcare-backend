model DoctorProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  avatarId          String?     @unique @map("avatar_id")
  avatar            Attachment? @relation("DoctorAvatar", fields: [avatarId], references: [id], onDelete: Cascade)
  title             String?
  specialty         String?
  bio               String?     @db.Text
  licenseNumber     String?
  npiNumber         String?
  yearsOfExperience Int?
  officeLocation    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  sideEffectReports SideEffectReport[]

  // @@index([status])
  // @@index([officeLocationId])

  @@index([name])
  @@index([userId])
  @@index([title])
}
