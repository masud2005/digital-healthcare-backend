model DoctorProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  avatarId       String?     @unique @map("avatar_id")
  avatar         Attachment? @relation("DoctorAvatar", fields: [avatarId], references: [id], onDelete: Cascade)
  title          String?
  featured       Boolean     @default(false)
  specialty      String?
  bio            String?     @db.Text
  officeLocation String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  sideEffectReports SideEffectReport[]
  blogs             Blog[]

  @@index([name])
  @@index([userId])
  @@index([title])
}

model AdminProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  avatarId       String?     @unique @map("avatar_id")
  avatar         Attachment? @relation("AdminAvatar", fields: [avatarId], references: [id], onDelete: Cascade)
  title          String?
  specialty      String?
  bio            String?     @db.Text
  officeLocation String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([name])
  @@index([userId])
}

model PatientProfile {
  id        String      @id @default(uuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatarId  String?     @unique @map("avatar_id")
  avatar    Attachment? @relation("PatientAvatar", fields: [avatarId], references: [id], onDelete: Cascade)
  address   String?
  city      String?
  state     String?
  zipCode   String?
  bio       String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([userId])
}
