model DoctorProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  avatarId          String?     @unique @map("avatar_id")
  avatar            Attachment? @relation("DoctorAvatar", fields: [avatarId], references: [id], onDelete: Cascade)
  title             String?
  featured          Boolean     @default(false)
  specialty         String?
  bio               String?     @db.Text
  licenseNumber     String?
  npiNumber         String?
  yearsOfExperience Int?
  officeLocation    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  sideEffectReports SideEffectReport[]

  @@index([name])
  @@index([userId])
  @@index([title])
}

model PatientProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  avatarId    String?      @unique @map("avatar_id")
  avatar      Attachment?  @relation("PatientAvatar", fields: [avatarId], references: [id], onDelete: Cascade)
  address     String?
  city        String?
  state       String?
  zipCode     String?
  bio         String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([name])
  @@index([userId])
}
