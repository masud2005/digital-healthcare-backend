        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.2.1",
        "@nestjs/websockets": "^11.1.27",
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "@softvence/mail": "^0.0.5",
        "@softvence/s3": "^0.0.5",
        "@types/cookie-parser": "^1.4.10",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.6",
        "express": "^5.1.0",
        "handlebars": "^4.7.9",
        "jsonwebtoken": "^9.0.0",
        "multer": "^2.1.1",
        "node-cache": "^5.1.2",
