{$LIVE_DOMAIN} {
    reverse_proxy app_live:5056 {

        # Health check endpoint for upstream
        health_path /api/health
        health_interval 10s
        health_timeout 5s
    }
}

{$PRE_DOMAIN} {
    reverse_proxy app_pre:5056 {

        # Health check endpoint for upstream
        health_path /api/health
        health_interval 10s
        health_timeout 5s
    }
}